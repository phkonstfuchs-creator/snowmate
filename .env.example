# Browser-safe Supabase values. Never add service-role or secret keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: the VAPID *public* key for push notifications (ADR 0025).
# The private key belongs only in the Supabase edge function secrets.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
