# Public canonical URL, without a trailing slash. Set before production build.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Server-only credentials from the existing Supabase project.
# Never use NEXT_PUBLIC_ for the service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WAITLIST_RATE_LIMIT_SECRET=

# Public operator details. Do not set these to invented values.
PISTL_OPERATOR_NAME=
PISTL_OPERATOR_ADDRESS=
PISTL_CONTACT_EMAIL=

# Keep false until legal pages, storage, and launch checklist are complete.
PISTL_LAUNCH_READY=false
